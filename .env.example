# ── Market War Room ─────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development.
#
# Phase 2 runs fine in DEMO mode with NO credentials — nothing is required.
# For live market data, add provider credentials and set the relevant modes.
#
# Never commit real secrets. Credentials are server-side only and must never
# be exposed with a NEXT_PUBLIC_ prefix or placed in client components.
# ─────────────────────────────────────────────────────────────────────────

# Market data mode: `demo` or `live` (default: demo)
#   demo → typed fixtures, no credentials, no network calls
#   live → Market Pulse + Sector Rotation + header status from Alpaca
MARKET_DATA_MODE=demo

# Macro data mode: `demo` or `live` (default: demo) — independent of the
# equities mode, so "equities live + macro demo" and both-live are supported.
#   demo → typed macro fixtures
#   live → VIX/US 10Y/Broad USD/WTI from FRED, Gold from Twelve Data (XAU/USD),
#          BTC from Alpaca
MACRO_DATA_MODE=demo

# Regime data mode: `demo` or `live` (default: demo).
#   demo → deterministic demo RegimeResult fixture (no analytics service needed)
#   live → the Python analytics service scores a RegimeInput built from the
#          live market + macro overviews. Requires MARKET_DATA_MODE=live and
#          MACRO_DATA_MODE=live; if the analytics service is down, Market
#          Regime renders unavailable (Market/Macro Pulse keep working).
REGIME_MODE=demo

# Python analytics service base URL + per-request timeout (milliseconds).
ANALYTICS_BASE_URL=http://127.0.0.1:8000
REGIME_TIMEOUT_MS=4000

# Market Breadth mode: `demo` or `live` (default: demo).
#   demo → deterministic demo breadth fixture
#   live → S&P 500 breadth from Alpaca delayed-SIP snapshots + history
#          (feed=delayed_sip, 15-minute delay). Requires ALPACA credentials.
#          Historical bars use feed=sip with `end` set safely before the
#          restricted recent-15-minute window (Basic entitlement).
BREADTH_MODE=demo

# Market Anomalies mode: `demo` or `live` (default: demo).
#   demo → deterministic demo anomaly fixture
#   live → S&P 500 statistical anomaly scanner on Alpaca delayed-SIP data
#          (feed consistency: stock vs sector-ETF moves both use delayed SIP;
#          historical bars use adjustment=split). Requires ALPACA credentials.
ANOMALIES_MODE=demo

# ── Alpaca Market Data API (server-side only) ────────────────────────────
# Also used for BTC/USD crypto data in live macro mode.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Data feed. Alpaca Basic uses real-time IEX equity data — NOT the full
# consolidated SIP feed. Keep this visible to users in the UI.
ALPACA_DATA_FEED=iex

ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# ── FRED (VIX, US 10Y — daily observations) ──────────────────────────────
FRED_API_KEY=
# Dev/test override for the FRED API base (default: https://api.stlouisfed.org/fred)
# FRED_BASE_URL=https://api.stlouisfed.org/fred

# ── Twelve Data (WTI, DXY, Gold — intraday quotes) ───────────────────────
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Provider tuning
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_STALE_AFTER_MS=120000
MACRO_DATA_TIMEOUT_MS=8000

# Macro freshness thresholds by source frequency (milliseconds)
# FRED is a daily feed: stale only when unusually old, not after minutes.
MACRO_STALE_AFTER_MS_REALTIME=300000
MACRO_STALE_AFTER_MS_INTRADAY=900000
MACRO_STALE_AFTER_MS_DAILY=259200000

# ── Local app ─────────────────────────────────────────────────────────────
PORT=3000
ANALYTICS_PORT=8000

# ── Phase 6 · Catalyst Intelligence ───────────────────────────────────────
# demo | live  (live additionally requires ANOMALIES_MODE=live)
CATALYSTS_MODE=demo
# Required for SEC EDGAR lookups. Format: "MarketWarRoom <contact@example.com>"
# SEC requests are skipped (provider disabled) while this is empty.
SEC_USER_AGENT=MarketWarRoom contact@example.com

